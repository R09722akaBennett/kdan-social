# Postgres connection string. Local: docker run --rm -d -e POSTGRES_PASSWORD=dev -p 54329:5432 postgres:17
DATABASE_URL=postgres://postgres:dev@localhost:54329/postgres

# 32 random bytes, base64. Encrypts every saved platform token; changing it forces all accounts to reconnect.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KDAN_SOCIAL_SECRET_KEY=

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>". Unset means the cron routes refuse every call.
CRON_SECRET=

# Deployment-wide publishing switch. Anything but 1 keeps every workspace in dry-run.
PUBLISHING_ENABLED=0

# Supabase Auth and Storage. The URL and publishable key are public; RLS keeps the Data API from reading any table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Signs media upload URLs and bypasses RLS: server-only, never expose to the browser.
SUPABASE_SECRET_KEY=

# Meta app used by the "connect Facebook" flow. Publishing reads the stored page tokens, not these.
META_APP_ID=
META_APP_SECRET=

# Comma-separated codes that let someone create a workspace at sign-up. Empty means invite-only.
SIGNUP_CODES=

# AI writing tools, all served through GCP Vertex AI. Unset AI_MODEL hides every AI action.
# Format vertex/<model>, e.g. vertex/gemini-3.8-flash, vertex/claude-opus-5-5, vertex/xai/grok-4.
AI_MODEL=
# Optional: a different model for the analytics findings, e.g. vertex/gemini-4-argon.
AI_MODEL_INSIGHTS=
GCP_PROJECT_ID=
# Vertex region; some partner models are only in certain regions.
GCP_LOCATION=global
# Service account key JSON with the Vertex AI User role. Leave empty locally to use `gcloud auth application-default login`.
GCP_SERVICE_ACCOUNT_JSON=
